# Copy this file to `keystore.properties` (same folder) and fill in your values.
# `keystore.properties` is git-ignored — it must NEVER be committed.
#
# Create the keystore first (see docs/release-checklist.md):
#   keytool -genkey -v -keystore gemleap-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias gemleap
#
# storeFile is relative to the repo root.

storeFile=gemleap-release.jks
storePassword=CHANGE_ME
keyAlias=gemleap
keyPassword=CHANGE_ME
